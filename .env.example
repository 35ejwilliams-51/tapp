# Copy this file to ".env" and fill in your keys. Never commit ".env".

# Finnhub — free tier. Get a key at https://finnhub.io/register (no card needed).
# With this set, TAPP auto-connects to the live feed on load.
VITE_FINNHUB_KEY=

# Clerk — auth, free tier (up to 50K users). Get a key at https://clerk.com
# (Dashboard → API keys → Publishable key). With this set, TAPP shows Clerk's
# real sign-in; without it, the built-in mock login is used.
VITE_CLERK_PUBLISHABLE_KEY=
