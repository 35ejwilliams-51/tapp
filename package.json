{
  "name": "tapp-founder-prototype",
  "private": true,
  "version": "0.0.3-m0-unified",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "node --experimental-strip-types apps/api/src/server.ts",
    "dev:web": "npm run dev --workspace @tapp/web",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "build": "npm run build --workspace @tapp/web && node scripts/build.mjs",
    "provider:check": "node scripts/provider-check.mjs",
    "start": "node --experimental-strip-types apps/api/src/server.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module"
}
